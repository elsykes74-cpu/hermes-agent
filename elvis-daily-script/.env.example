# The King Lives — Elvis Pipeline Environment Variables
# Copy this file to .env and fill in your keys
# cp .env.example .env

# ── RunPod (GPU backend for voice + images) ───────────────────────────────────
# Get your API key from: runpod.io → Settings → API Keys
RUNPOD_API_KEY=...

# These are auto-set when you run: python elvis_pipeline.py --setup-runpod
RUNPOD_FLUX2_ENDPOINT_ID=
RUNPOD_QWEN3TTS_ENDPOINT_ID=

# ── YouTube upload ────────────────────────────────────────────────────────────
# Path to your client_secret_*.json downloaded from Google Cloud Console
# Setup: GCP → APIs & Services → Credentials → Create → Desktop app → Download
# Enable: YouTube Data API v3 in your GCP project
YOUTUBE_CLIENT_SECRETS_FILE=/path/to/client_secret_123.json
